{
  "name": "bid-wit-me",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p packages/rules && tsc -p packages/bots && tsc -p apps/web --noEmit",
    "simulate": "tsx scripts/simulate.ts",
    "dev": "pnpm --filter @spades/web dev",
    "build": "pnpm --filter @spades/web build",
    "preview": "pnpm --filter @spades/web preview",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.10.2",
    "node-turn": "^0.0.6",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@spades/bots": "workspace:*",
    "@spades/rules": "workspace:*"
  }
}
